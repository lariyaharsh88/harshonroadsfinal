# HarshOnRoads
#
# No environment variables are required to build or deploy the static site.
# There is no database or auth on this launch.
#
# Optional: public site origin for canonical URLs, sitemap.xml, and Open Graph.
# If unset, the site uses https://harshonroads.com
# NEXT_PUBLIC_SITE_URL=https://harshonroads.com
#
# Server-only. Never prefix with NEXT_PUBLIC_.
# Required only when calling AI travel tools.
GEMINI_API_KEY=
